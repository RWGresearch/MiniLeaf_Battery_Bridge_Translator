    {
      "inputs": [
        "capacity_pack1_ah"
      ],
      "combine": "linear",
      "output": "capacity_bars_raw",
      "params": {
        "scale": 0.07,
        "offset": 0.0
      },
      "name": "capacity_pack1_ah -> capacity_bars_raw (confirmed 0-200Ah = 0-14 bars)"
    },
    {
      "inputs": [
        "temp_max"
      ],
      "combine": "linear",
      "output": "batt_temp_c",
      "params": {
        "scale": 1.0,
        "offset": 0.0
      },
      "name": "temp_max (\u00b0C) -> batt_temp_c (\u00b0C) (identity - both already \u00b0C as of 2026-08-09)"
    },
    {
      "inputs": [
        "capacity_pack1_ah"
      ],
      "combine": "soh_percent",
      "output": "soh_pct",
      "params": {
        "nameplate_ah": 201.0
      },
      "name": "capacity_pack1_ah -> soh_pct"
    },
    {
      "inputs": [
        "temp_max"
      ],
      "combine": "linear",
      "output": "temp_segment_pct",
      "params": {
        "scale": 1.6666666666666667,
        "offset": 0.0
      },
