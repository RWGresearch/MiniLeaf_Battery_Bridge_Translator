    {
      "inputs": [
        "soc_pct"
      ],
      "combine": "linear",
      "output": "soc_correction",
      "params": {
        "scale": 2.0,
        "offset": 0.0
      },
      "name": "soc_pct -> soc_correction (dash SOC% display, confirmed 2 raw counts/%)"
